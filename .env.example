# URL chính thức của website (dùng cho canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://phuc.nhanhieuso.vn

# Google Analytics 4 (tùy chọn). Để trống để tắt.
NEXT_PUBLIC_GA_ID=

# ---- Contact form: chọn MỘT trong hai kênh gửi ----
# Không cấu hình kênh nào: dev chỉ log ra console, production trả lỗi 503.

# Kênh 1: Webhook nhận JSON { name, email, subject, message, text, locale }
# (n8n, Make, Zapier, Slack/Discord bridge…)
CONTACT_WEBHOOK_URL=

# Kênh 2: Gửi email qua Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Địa chỉ gửi phải thuộc domain đã xác minh trên Resend, ví dụ "Website <noreply@nhanhieuso.vn>"
CONTACT_FROM_EMAIL=
